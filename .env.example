# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (Шума, Ксеня)
ADMIN_IDS=
# Ссылка на оплату
PAYMENT_URL=https://shumkadance.tb.ru/
# console — код показывается в чате (тестовый режим); smsru — настоящие SMS через SMS.ru
SMS_PROVIDER=console
SMSRU_API_KEY=
# Путь к базе данных и папке с подписанными PDF
DATA_DIR=./data
# Реквизиты исполнителя для договора
EXECUTOR_NAME=
EXECUTOR_INN=
EXECUTOR_OGRNIP=
EXECUTOR_CITY=
# Часовой пояс для дат в договоре (например Europe/Kaliningrad)
TIMEZONE=Europe/Moscow
